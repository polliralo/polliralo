{
  "name": "nivara-coast",
  "version": "1.0.0",
  "private": true,
  "description": "NIVARA COAST, a fictional private-island resort concept. Static website (HTML, CSS, vanilla JS).",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "media": "node scripts/build-media.mjs",
    "screens": "node scripts/screenshots.mjs",
    "zip": "node scripts/build-zip.mjs",
    "lint": "html-validate site/index.html",
    "test": "playwright test",
    "check": "npm run lint && npm test",
    "shop:start": "node shop/scripts/serve.mjs",
    "shop:media": "node shop/scripts/media.mjs",
    "shop:og": "node shop/scripts/og.mjs",
    "shop:build": "node shop/scripts/build.mjs",
    "shop:lint": "html-validate --config shop/.htmlvalidate.json \"shop/site/**/*.html\"",
    "shop:test": "playwright test --config playwright.shop.config.mjs",
    "shop:check": "npm run shop:build && npm run shop:lint && npm run shop:test",
    "shop:zip": "node shop/scripts/zip.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "html-validate": "^9.0.0",
    "sharp": "^0.34.0"
  }
}
