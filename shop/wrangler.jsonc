// Cloudflare Workers config for the MONO shop (static assets only, no server code).
// Deploy from the repository root with:  npx wrangler deploy --config shop/wrangler.jsonc
// or upload the contents of shop/site in the Cloudflare dashboard.
{
  "name": "mono-shop",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
