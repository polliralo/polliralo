{
  "root": true,
  "extends": [
    "html-validate:recommended"
  ],
  "rules": {
    "no-redundant-role": "off",
    "prefer-native-element": [
      "error",
      {
        "exclude": [
          "list"
        ]
      }
    ],
    "no-inline-style": [
      "error",
      {
        "allowedProperties": [
          "--lqip"
        ]
      }
    ],
    "tel-non-breaking": [
      "error",
      {
        "ignoreClasses": [
          "btn",
          "nowrap"
        ]
      }
    ]
  }
}
