{
  "extends": [
    "html-validate:recommended"
  ],
  "rules": {
    "no-redundant-role": "off",
    "prefer-native-element": [
      "error",
      {
        "exclude": [
          "list"
        ]
      }
    ],
    "no-inline-style": [
      "error",
      {
        "allowedProperties": [
          "--x",
          "--y",
          "--pos",
          "--reveal-delay",
          "--lqip"
        ]
      }
    ]
  }
}
